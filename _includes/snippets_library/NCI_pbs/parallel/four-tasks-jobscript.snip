```
#!/bin/bash
#PBS -P cd82
#PBS -N parallel-job
#PBS -l mem=3gb
#PBS -l ncpus=4
#PBS -l walltime=00:30:00
#PBS -l storage=scratch/cd82
#PBS -l wd

module load python3
module unload compilers mpi
module load openmpi

pwd

source /scratch/cd82/am9079/pythoninstalls/bin/activate

# Execute the task
mpirun -np $PBS_NCPUS amdahl

deactivate

echo "Complete"

